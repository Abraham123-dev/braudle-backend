# === SERVER ===
PORT=5000
NODE_ENV=development

# === DATABASE ===
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/braudle?retryWrites=true&w=majority

# === REDIS ===
REDIS_URL=redis://localhost:6379

# === JWT ===
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# === GOOGLE OAUTH ===
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# === GROQ API ===
GROQ_API_KEY=gsk_your_groq_api_key

# === HUGGING FACE ===
HUGGINGFACE_API_KEY=hf_your_huggingface_token

# === CLOUDFLARE R2 ===
CF_ACCOUNT_ID=your_cf_account_id
CF_R2_ACCESS_KEY=your_r2_access_key
CF_R2_SECRET_KEY=your_r2_secret_key
CF_R2_BUCKET=braudle-uploads
# Use your public bucket URL or custom domain, e.g. https://pub-xxxxxxxx.r2.dev
CF_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# === FRONTEND ===
FRONTEND_URL=http://localhost:3000

{
  "name": "braudle-backend",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n \"server,worker\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:worker\"",
    "dev:server": "nodemon server.js",
    "dev:worker": "nodemon src/workers/document.worker.js",
    "worker": "nodemon src/workers/document.worker.js",
    "flush:queues": "node scripts/flush-bullmq-versions.js",
    "queue:inspect": "node scripts/migrate-bullmq.js --mode=inspect",
    "queue:flush": "node scripts/migrate-bullmq.js --mode=flush",
    "queue:migrate": "node scripts/migrate-bullmq.js --mode=migrate",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abraham123-dev/braudle-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Abraham123-dev/braudle-backend/issues"
  },
  "homepage": "https://github.com/Abraham123-dev/braudle-backend#readme",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pdf-parse": "^1.1.5",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "bullmq": "5.80.6",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "groq-sdk": "^1.2.1",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
